# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local
# Per-instance secrets: .env.zero, .env.ops-big
.env.*
!.env.example

# Per-machine instance config. egirl.toml is tracked, so live endpoints and instance layout
# appended to it show up as a permanent working-tree diff and are one `git add -A` from being
# committed. Fragments keep that out of the repo.
egirl.d/

# Workspace (keep templates)
workspace/*
!workspace/.gitkeep

# SQLite databases
*.db
*.sqlite

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
.codex
.codex/
*.swp
*.swo
.ipynb_checkpoints/

# Logs
*.log

# Test coverage
coverage/

# Python (embedding service)
venv/
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/

# Ladder transcripts: full prompts and tool output per task, large and private training material
bench/ladder/transcripts/
